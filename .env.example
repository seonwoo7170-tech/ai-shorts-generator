# Copy this file to .env and fill in your keys. .env is gitignored.
# Everything here is optional except the keys for the features you use.

# ── APIs ────────────────────────────────────────────────────────────────────
# OpenAI — script (structured outputs), voiceover (TTS), captions alignment,
# and clip-matching embeddings. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# fal.ai — AI images (Flux) and AI motion clips (Wan). Only needed if you use AI
# visuals. Get one at https://fal.ai/dashboard/keys
FAL_KEY=...

# Pexels — FREE real stock footage for the clip library. https://www.pexels.com/api/
PEXELS_API_KEY=
# Optional second free stock source. https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ── Visuals ─────────────────────────────────────────────────────────────────
# Image backend for each scene: "fal" (Flux, needs FAL_KEY) or "local" (SDXL on a
# CUDA GPU, free — needs requirements-gpu.txt + a CUDA build of torch).
IMAGE_BACKEND=fal

# Motion: "none" = free Ken Burns zoom/pan (default, cost-safe);
#         "all"  = animate every scene with the i2v model (best, costs fal credit);
#         "N"    = animate the N most important scenes.
ANIMATE=none

# i2v model + image model (override only if a fal slug changes).
# I2V_MODEL=fal-ai/wan/v2.2-5b/image-to-video
# FAL_FLUX_MODEL=fal-ai/flux/dev

# ── Voice ───────────────────────────────────────────────────────────────────
# TTS voice: ash/sage/onyx/alloy/echo/nova/shimmer/coral/ballad/verse
TTS_VOICE=onyx
# Extra playback speed-up for a punchy delivery (1.0 = none).
SPEECH_TEMPO=1.15

# ── Captions ────────────────────────────────────────────────────────────────
# faster-whisper device ("cuda" or "cpu") and model ("small"/"medium"/"large-v3").
# Auto-falls back to CPU if CUDA libs aren't installed.
WHISPER_DEVICE=cpu
WHISPER_MODEL=small

# ── Content ─────────────────────────────────────────────────────────────────
# Optional niche to focus the scriptwriter (e.g. "personal finance",
# "fitness motivation", "tech explainers"). Leave blank for purely topic-driven.
CONTENT_NICHE=
# Optional scriptwriter preset from prompts/presets/ (filename, without .md).
# Leave blank to use the default writer. See prompts/presets/README.md.
SCRIPT_PROMPT=
# Spoken length target (seconds).
TARGET_SECONDS=20

# ── Branding (watermark + optional outro) ───────────────────────────────────
# Watermark is ON by default and appears once you drop a square PNG at
# assets/logo/logo.png and/or set a disclaimer below. Set WATERMARK=false to disable.
WATERMARK=true
BRAND_NAME=Your Brand
BRAND_URL=
BRAND_TAGLINE=
BRAND_DISCLAIMER=

# Optional end card stitched onto every video (off by default). When ON, it uses the
# BRAND_* values + assets/logo/logo.png, with a spoken call-to-action.
OUTRO=false
# OUTRO_VO_TEXT=Follow Your Brand.

# Accent colors used by the outro card and the dashboard (hex).
# BRAND_ACCENT=#6366F1
# BRAND_ACCENT_2=#8B5CF6

# ── Shopping shorts (python run.py shop ...) — see docs/SHOPPING_KO.md ──────
# Krea API key (the only one of the 4 tools with a public API). https://www.krea.ai/
KREA_API_KEY=
# Model endpoints (change if Krea renames a slug). Video = image/text -> clip.
# KREA_IMAGE_MODEL=/generate/image/krea/krea-2/medium
# KREA_VIDEO_MODEL=/generate/video/kling/kling-2.5
# KREA_VIDEO_SECONDS=5
# Spend cap: max Krea video jobs per short.
KREA_MAX_VIDEOS=3

# Which tool makes each scene role: krea (auto) | meta | vibes | dola (handoff) | card
SHOP_ROUTE=hook=vibes,problem=meta,hero=krea,usage=dola,benefit=krea,cta=card
# With --auto, a missing Meta/Vibes/Dola file is filled by: krea | photo
SHOP_MANUAL_FALLBACK=krea

SHOP_LANGUAGE=Korean
SHOP_TARGET_SECONDS=25
SHOP_CURRENCY=원
SHOP_CTA_TEXT=구매 링크는 고정 댓글에!
# Affiliate disclosure appended to descriptions when the product has a url.
# SHOP_DISCLOSURE=이 콘텐츠는 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.
# Korean font: card font file path, and caption font family (installed or in assets/fonts).
# SHOP_FONT=assets/fonts/NotoSansKR-Bold.ttf
# CAPTION_FONT=Noto Sans KR
